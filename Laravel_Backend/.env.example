APP_NAME="ChatCart Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.example.com
CHATCART_VERSION=1.0.0

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatcart
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

FIREBASE_PROJECT_ID=YOUR_PRODUCTION_PROJECT_ID
FIREBASE_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FCM_TOPIC=chatcart-production

DEFAULT_COMMISSION_PERCENT=5
