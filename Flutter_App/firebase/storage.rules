rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function imageUnder10MB() { return request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }

    match /chat_media/{conversationId}/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageUnder10MB();
    }

    match /marketplace/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && imageUnder10MB();
    }

    match /kyc/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && imageUnder10MB();
    }
  }
}
