rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant(data) { return signedIn() && request.auth.uid in data.participants; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.revoked == false;
        allow update: if signedIn() && request.auth.uid == uid
          && resource.data.revoked != true
          && request.resource.data.revoked == resource.data.revoked
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token','platform','topics','updatedAt']);
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow read, update: if isParticipant(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }

      match /reads/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }
  }
}
